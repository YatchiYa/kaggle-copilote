# ---- Kaggle (required) ----------------------------------------------------
# Token from https://www.kaggle.com/settings/api  (or drop kaggle.json in the project root)
KAGGLE_API_TOKEN=

# ---- LLM: pick ONE line ---------------------------------------------------
# none        -> no LLM, built-in baseline engine (free, tabular only)
# claude-code -> uses your logged-in `claude` CLI, no API keys at all
PODIUM_MODEL=none
# PODIUM_MODEL=claude-code
# PODIUM_CLAUDE_CODE_MODEL=opus            # optional, empty = your Claude Code default

# Ollama (local / other laptop): `ollama pull qwen2.5-coder:14b`
# PODIUM_MODEL=ollama_chat/qwen2.5-coder:14b
# OLLAMA_API_BASE=http://localhost:11434

# Gemini
# PODIUM_MODEL=gemini/gemini-2.5-pro
# GEMINI_API_KEY=

# Anthropic API
# PODIUM_MODEL=anthropic/claude-opus-5-5
# ANTHROPIC_API_KEY=

# AWS Bedrock (uses your normal AWS credentials / profile)
# PODIUM_MODEL=bedrock/anthropic.claude-opus-5-5
# AWS_REGION_NAME=us-east-1
# AWS_PROFILE=default

# OpenAI
# PODIUM_MODEL=openai/gpt-5
# OPENAI_API_KEY=

# ---- AI model per role (overrides the lines above) ---------------------------------------
# Format: claude-code:<model> | anthropic/<model> | bedrock/<model-id> | gemini/<model> | openai/<model> | ollama_chat/<model>
# PODIUM_MODEL_STRATEGY=claude-code:claude-fable-5-1     # plan, reflect, web research
# PODIUM_MODEL_EXPERIMENT=claude-code:claude-opus-5-5    # writes experiments (one conversation per competition)
# PODIUM_MODEL_REVIEW=claude-code:claude-opus-5-5        # code review gate before submit
# PODIUM_MODEL_COPILOT=claude-code:claude-opus-5-5       # dashboard chat
# PODIUM_CONVERSATIONS=1
# PODIUM_CONVERSATION_MAX_TURNS=40
# PODIUM_RESEARCH=1
# PODIUM_FALLBACK_MODEL=anthropic/claude-sonnet-5-5   # used while Claude Code hits a plan usage limit
# PODIUM_BACKUP_KEEP=7

# ---- Engine & sandbox -----------------------------------------------------
# PODIUM_ENGINE=llm            # default: baseline if PODIUM_MODEL=none, else llm
PODIUM_SANDBOX=docker          # docker (build once: docker build -t podium-sandbox sandbox/) | local
# PODIUM_EXPERIMENT_TIMEOUT_S=1800

# ---- Fleet ----------------------------------------------------------------
# PODIUM_LOOP_SECONDS=60       # pause between fleet passes
# PODIUM_MAX_ACTIVE=3          # competitions worked on at once
# PODIUM_KINDS=tabular         # comma list: tabular,cv,nlp,other
# PODIUM_MAX_EXPERIMENTS=40    # per competition run
# PODIUM_MIN_CHANCE=45         # only work on competitions with rank-chance score >= this (0-100)
# PODIUM_SCOUT_SECONDS=3600     # look for new competitions hourly
# PODIUM_REFLECT_EVERY=4        # strategist re-plans after N experiments (and after each new LB score)
# PODIUM_REVIEW=1               # expert LLM code review must pass before any LLM-written submission
# PODIUM_NOTIFY_URL=https://ntfy.sh/your-secret-topic   # or a Slack/Discord webhook: scores, rank, tasks
# Dedicated projects: launch the public-notebook baseline automatically (one at a time)
PODIUM_PROJECT_AUTOPILOT=1
PODIUM_AUTO_SUBMIT=1           # 0 = never submit to Kaggle, just experiment
# PODIUM_DAILY_SUBMISSIONS=0   # 0 = each competition's own Kaggle daily limit

# ---- Spend caps (LLM $ and compute hours) ---------------------------------
# PODIUM_COMP_CAP_USD=20
# PODIUM_COMP_CAP_HOURS=10
# PODIUM_WEEKLY_CAP_USD=50

# ---- Notifications ----------------------------------------------------------
# PODIUM_NOTIFY_EMAIL=you@example.com     # alerts by email (needs the SMTP_* lines)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                            # 465 = SSL, 587 = STARTTLS
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=                           # Gmail: an App Password, not your normal password
# FROM_EMAIL=you@gmail.com
# FROM_NAME=Podium
# PODIUM_PUBLIC_URL=http://192.168.1.20:8000   # dashboard link inside alerts

# ---- Dashboard ----------------------------------------------------------------
# PODIUM_FLEET=1               # 0 = dashboard only (run ONE active fleet per Kaggle account)
# PODIUM_HOST=127.0.0.1         # 0.0.0.0 to open it on your phone (LAN); then PODIUM_PASSWORD is required
# PODIUM_PORT=8000
# PODIUM_PASSWORD=              # HTTP Basic auth password (any username)
